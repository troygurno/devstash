# Neon Postgres — the DEV branch connection string.
# Neon dashboard → your project → Branches → development → Connection string.
# Use the pooled URL; the Neon serverless driver handles pooling for us.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/devstash?sslmode=require"

# Auth.js v5 — signs and encrypts the JWT session cookie.
# Generate with `npx auth secret`, or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# GitHub OAuth app — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# The AUTH_<PROVIDER>_ID / _SECRET names are read by Auth.js automatically.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
